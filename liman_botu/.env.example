# --- Telegram ---
# @BotFather'dan aldığın token
TELEGRAM_TOKEN=123456:ABC-DEF...

# Botu sadece kendin kullanacaksan, kendi Telegram User ID'ni yaz.
# Virgülle birden fazla ID girebilirsin. Boş bırakırsan herkes kullanabilir.
ALLOWED_USER_IDS=123456789

# --- Yapay Zeka / API'ler ---
GEMINI_API_KEY=...
TMDB_API_KEY=...
RAWG_API_KEY=...       # /oynadim için (rawg.io/apidocs — ücretsiz)
# /havadurumu Open-Meteo kullanır, ANAHTAR GEREKTİRMEZ.

# --- Obsidian klasörleri (TAM yol; her modül kendi alt klasörüne yazar) ---
# Örn (Windows): C:/Users/Kullanici/Documents/Vault/Medya
# Örn (Linux/Mac): /home/kullanici/Obsidian/Vault/Medya
OBSIDIAN_MEDYA_PATH=./vault/Medya
OBSIDIAN_OYUN_PATH=./vault/Oyunlar
OBSIDIAN_FINANS_PATH=./vault/Finans
