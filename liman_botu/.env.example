# =========================================================================
# Telegram (ZORUNLU)
# =========================================================================
# @BotFather'dan aldığın token
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Zamanlanmış sabah raporunun (07:30) gideceği sohbet.
# Botu çalıştırıp /kimlik yazınca sana bu ID'yi verir.
TELEGRAM_CHAT_ID=123456789

# Botu sadece izinli kişiler kullansın (virgülle çoklu). Boş bırakırsan
# TELEGRAM_CHAT_ID otomatik izinli sayılır.
ALLOWED_USER_IDS=

# =========================================================================
# Yapay Zeka / API'ler (medya, oyun, finans modülleri için)
# =========================================================================
GEMINI_API_KEY=...
TMDB_API_KEY=...
RAWG_API_KEY=...
# Hava durumu Open-Meteo kullanır, ANAHTAR GEREKTİRMEZ.

# Liman scraping için (opsiyonel; boşsa varsayılan endpoint denenir)
PORT_DATA_URL=

# Otomatik (zamanlanmış 07:30/18:00) veri çekme. Varsayılan KAPALI.
# Kapalıyken liman verisi yalnızca sen komut girince çekilir. Açmak için: 1
LIMAN_OTOMATIK=0

# =========================================================================
# Obsidian klasörleri (TAM yol; her modül kendi alt klasörüne yazar)
# Windows'ta düz slash (/) kullan.
# =========================================================================
OBSIDIAN_MEDYA_PATH=./vault/Medya
OBSIDIAN_OYUN_PATH=./vault/Oyunlar
OBSIDIAN_FINANS_PATH=./vault/Finans
